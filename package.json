{
  "name": "ghost-cms-to-markdown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-local Ghost JSON export to Markdown converter.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
