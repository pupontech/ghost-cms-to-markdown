{
  "name": "ghost-cms-to-markdown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Credential-free, browser-local Ghost JSON export to Markdown converter.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hast-util-from-parse5": "8.0.3",
    "hast-util-to-html": "9.0.5",
    "hast-util-to-mdast": "10.1.2",
    "jszip": "^3.10.1",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-markdown": "2.1.2",
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
